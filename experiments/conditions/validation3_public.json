 "grid_levels": {
  "challenge": "After the P x P crop and plane removal of S5.2 (P = 512 or 1024): sides P, P/2 and P/4, made with decimate_fourier (primary) and with subsample (control that keeps aliasing).",
  "tdf": "S5.4 (decimate_fourier per component, renormalised and re-encoded as uint8)."
 },
 "descriptors_challenge": [
  {
   "name": "hf_ratio_px",
   "rule": "z in metres converted to a normal map by S2.8 (pixel spacing equal to the physical spacing); freq_threshold = 120 (fixed in pixels)."
  },
  {
   "name": "hf_ratio_phys",
   "rule": "Same normal map; freq_threshold = 120 n / P (fixed relative to the physical domain of the crop; n is the side of the grid)."
  },
  {
   "name": "centroid_amp",
   "rule": "S2.3 (raw)."
  },
  {
   "name": "centroid_amp_hann",
   "rule": "S3.1, then S2.3."
  },
  {
   "name": "centroid_band_power",
   "rule": "S2.4 with K = P/8 (K <= n/2 at every grid) and power weighting."
  },
  {
   "name": "sq",
   "rule": "S2.5."
  },
  {
   "name": "hf_ratio_px_float",
   "rule": "As hf_ratio_px without uint8 rounding (S2.9, float variant)."
  }
 ],
 "descriptors_tdf": [
  {
   "name": "hf_ratio_px",
   "rule": "freq_threshold = 120."
  },
  {
   "name": "hf_ratio_phys",
   "rule": "freq_threshold = 120 n / n0, where n0 is the finest grid of the input (patch 240, tiled 1024)."
  }
 ],
 "comparisons": [
  "V1 (change of value): per measurement, the difference between the finest grid and one quarter of it.",
  "V2 (ordering): for every pair of measurements within a dataset and every pair of grids, flips. Measured data have no seeds, so a flip is a change of sign with relative difference |D_a - D_b| / ((D_a + D_b)/2) above 0.05 at both grids (all descriptors here are positive; threshold fixed before computing). Pairs of measurements from the same container (same specimen and group) are reported separately and not counted as independent; the main count uses pairs from different containers. Kendall's tau is also reported.",
  "V3 (rougher versus smoother): V2 restricted to pairs of one rougher and one smoother measurement (challenge).",
  "V4 (aliasing): difference between the decimate_fourier and subsample versions (challenge)."
 ],
 "predictions": [
  "P-V1 (Proposition 8, part 3): hf_ratio_px increases when the grid is coarsened, for every measurement. The change of hf_ratio_phys is smaller than that of hf_ratio_px.",
  "P-V2: hf_ratio_px shows at least one flip (definition of V2). hf_ratio_phys shows fewer flips than hf_ratio_px.",
  "P-V3: centroid_band_power is grid-independent for the decimate_fourier version up to rounding (the retained bins are the same). This is a check of the tools, not a finding.",
  "P-V4: centroid_amp (raw) decreases when the grid is coarsened. Whether flips occur is not predicted.",
  "P-V5 (tdf): hf_ratio_px increases when the grid is coarsened. Whether flips occur is not predicted (the inputs were already high-pass filtered)."
 ],
 "readouts": [
  "All values in long format: measurement, grid, decimation method, descriptor.",
  "Tables V1-V4.",
  "Reading rule: if flips are found on measured data, the effect is reported as not specific to synthetic surfaces; if none are found, this is reported together with the reference scale."
 ],
 "not_done": "Comparisons across instruments or scan sizes on the same specimen are excluded from the main analysis, because grid, bandwidth and probe are confounded (descriptive only, in the supplement). Line profiles (one-dimensional) are not used. A check on the generated outputs of Gao et al. (2026) will be added if their evaluated normal maps become available.",
 "deviations": [],
 "interpretation": "This is a test of robustness to resampling of one measurement on a fixed physical domain, not of re-measurement with different instruments.",
 "hf_ratio_order_of_operations": "challenge: z is decimated first and the normal map is computed at each grid with the pixel spacing of that grid; tdf: the normal map is decimated (no height is available). The float variant of S2.9 is computed beside the uint8 one.",
 "deviations_before_running": [
  "2026-10-25, before any computation: revised after a second opinion (Codex). Same-container pairs separated, interpretation stated, order of operations and float variant added."
 ]
}
